# Copy this file to ".env" (same folder as compose.yaml) and adjust it. Same idea as linuxserver.io containers.

# --- where things live ------------------------------------------------------------
# The folder that holds the database (/config inside the container).
# This is your EXISTING mbrowser sync folder, so its bookmarks, history, vault and token are migrated automatically.
CONFIG_PATH=/srv/dev-disk-by-uuid-9903b55c-c775-4bdc-9caf-319cd27eb39a/appdata/mybrowser-sync

# The port the web interface and the sync API listen on (on the host)
HTTP_PORT=4242

# --- who owns the files (run `id` on the server to see yours) ----------------------
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- optional --------------------------------------------------------------------
# Create the first administrator automatically instead of through the web page (only used while no account exists)
ADMIN_USER=
ADMIN_PASSWORD=

# true when the server sits behind a reverse proxy such as Nginx Proxy Manager (trusts X-Forwarded-For / -Proto)
TRUST_PROXY=true

# days a web login stays valid
SESSION_DAYS=7
