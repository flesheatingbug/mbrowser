<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar"
        android:padding="16dp"
        android:text="Passwords"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/pwTabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bar"
        android:orientation="horizontal">
        <TextView android:id="@+id/tabLogins" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="Logins"
            android:textColor="@color/accent" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/tabCards" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="Cards"
            android:textColor="@color/muted" android:textSize="14sp" />
        <TextView android:id="@+id/tabAddresses" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="Addresses"
            android:textColor="@color/muted" android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/pwStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <Button
        android:id="@+id/pwMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <EditText
        android:id="@+id/pwFilter"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="10dp"
        android:background="@drawable/bg_pill"
        android:hint="Search"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:textColor="@color/text"
        android:textColorHint="@color/muted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pwList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/pwBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView android:id="@+id/pwAdd" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp"
            android:gravity="center" android:text="Add" android:textColor="@color/accent" android:textSize="16sp" />
        <TextView android:id="@+id/pwSync" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp"
            android:gravity="center" android:text="Sync" android:textColor="@color/accent" android:textSize="16sp" />
        <TextView android:id="@+id/pwLock" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp"
            android:gravity="center" android:text="Lock" android:textColor="@color/accent" android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
