{
  "name": "mbrowser",
  "productName": "mbrowser",
  "version": "0.9.0",
  "description": "mbrowser: browse your way, with your data on your own server",
  "author": "mbrowser",
  "main": "main.js",
  "desktopName": "mbrowser.desktop",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.mbrowser",
    "productName": "mbrowser",
    "publish": {
      "provider": "generic",
      "url": "https://github.com/flesheatingbug/mbrowser/releases/download/latest-desktop/"
    },
    "files": [
      "**/*",
      "!server/**",
      "!android/**",
      "!tools/**",
      "!.github/**",
      "!dist/**",
      "!node_modules/.cache/**",
      "!*.cmd",
      "!*.sh",
      "!*.md"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/white-m.png",
      "category": "Network;WebBrowser",
      "artifactName": "mbrowser-linux.AppImage"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/white-m.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "mbrowser-windows-setup.exe"
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
